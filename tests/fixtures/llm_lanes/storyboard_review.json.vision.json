{
  "provider": "robo",
  "transport": "anthropic_messages",
  "base_url": "https://ai-api.d-robotics.cc",
  "api_key_env": "ROBO_API_KEY",
  "cc_switch_provider": "Zhipu GLM copy",
  "model": "kimi-k3",
  "supports_images": true,
  "use_proxy": false,
  "timeout_seconds": 300,
  "total_timeout_seconds": 900,
  "stream": true,
  "review_max_tokens": 12000,
  "configuration_source": "User authorized claude-glm configured API/key. Text completion and image capability independently checked; content review remains gated.",
  "vision_model": "glm-5.3-flash",
  "execution": "direct",
  "shell_settings_source": {
    "path": "~/.zshrc",
    "function": "claude-robo"
  }
}
