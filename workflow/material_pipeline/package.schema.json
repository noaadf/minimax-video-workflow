{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_id": {
      "type": "string",
      "pattern": "^material_[0-9a-f]{24}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "$ref": "#/$defs/event"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "transcript": {
      "$ref": "#/$defs/transcript"
    },
    "editorial": {
      "$ref": "#/$defs/editorial"
    },
    "collection_pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "production_pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "production_asset_plan_reviewed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "content_id",
    "title",
    "event",
    "sources",
    "facts",
    "assets",
    "shots",
    "transcript",
    "editorial",
    "collection_pending",
    "production_pending",
    "production_asset_plan_reviewed"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimax:material-package:1",
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "object": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity",
        "action",
        "date",
        "object"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "craft_reference"
          ]
        },
        "published": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_evidence": {
          "type": "string",
          "minLength": 1
        },
        "archive_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "acquisition": {
          "type": "string",
          "minLength": 1
        },
        "publication_index": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "publisher_article_card"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "archive_path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "text_path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "text_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "entry_start": {
              "type": "integer",
              "minimum": 0
            },
            "entry_end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "url",
            "archive_path",
            "sha256",
            "text_path",
            "text_sha256",
            "entry_start",
            "entry_end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "publisher",
        "role",
        "published",
        "date_evidence",
        "archive_path",
        "sha256",
        "text_path",
        "text_sha256",
        "retrieved_at",
        "acquisition"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source_id",
        "quote",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "enum": [
            "observed",
            "reported",
            "planned",
            "hypothesis"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification": {
          "enum": [
            "source_supported",
            "uncertain"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "text",
        "subject",
        "predicate",
        "object",
        "modality",
        "fingerprint",
        "verification",
        "evidence"
      ],
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "restricted",
            "licensed",
            "public_domain",
            "original"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidence_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "owner",
        "evidence_path",
        "note"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "video",
            "image",
            "audio"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "use": {
          "enum": [
            "research_only",
            "production"
          ]
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      },
      "required": [
        "id",
        "source_id",
        "url",
        "path",
        "sha256",
        "bytes",
        "kind",
        "duration",
        "use",
        "rights"
      ],
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "at": {
          "type": "number",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "at",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "candidate",
            "visually_reviewed"
          ]
        },
        "observation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          },
          "minItems": 1
        },
        "boundary_method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "asset_id",
        "start",
        "end",
        "status",
        "observation",
        "keyframes",
        "boundary_method"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "not_applicable",
            "automatic_unreviewed",
            "reviewed"
          ]
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "asset_id",
        "path",
        "sha256",
        "method",
        "limitations"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "original_narration": {
          "type": "string",
          "minLength": 1
        },
        "visual_plan": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "purpose",
        "fact_ids",
        "original_narration",
        "visual_plan"
      ],
      "additionalProperties": false
    },
    "editorial": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "type": "string",
          "minLength": 1
        },
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat"
          }
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "audience",
        "angle",
        "beats",
        "cautions",
        "verification_scope"
      ],
      "additionalProperties": false
    }
  }
}
